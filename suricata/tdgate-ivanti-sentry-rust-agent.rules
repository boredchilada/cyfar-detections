# tdgate-ivanti-sentry-rust-agent.rules
# Unlinked After OK: TDGate Delivery Commands Targeting Ivanti Sentry CVE-2026-10520
# https://github.com/boredchilada/cyfar-detections

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE-CNC TDGate default WebSocket gate or tunnel upgrade"; flow:to_server,established; http.method; content:"GET"; http.uri; pcre:"/^\/Q1fc8a9OCb7AsC6f\/ws(Gate|Tunnel)\?/"; content:"token="; distance:0; content:"&id="; distance:0; http.header; content:"Upgrade: websocket"; nocase; classtype:trojan-activity; priority:1; sid:1000876001; rev:2;)
alert tls $HOME_NET any -> any any (msg:"MALWARE-CNC TDGate direct-mode fake TLS SNI"; flow:to_server,established; tls.sni; pcre:"/^td-(gate|tun)\.local$/i"; classtype:trojan-activity; priority:1; sid:1000876002; rev:2;)
alert tcp $HOME_NET any -> any any (msg:"MALWARE-CNC TDGate cleartext HELLO or TUNHELLO handshake"; flow:to_server,established; pcre:"/^(\x00\x05HELLO\x00|\x00\x08TUNHELLO\x00)/s"; classtype:trojan-activity; priority:1; sid:1000876003; rev:2;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE-CNC TDGate C2 and delivery domain TLS SNI"; flow:to_server,established; tls.sni; dotprefix; content:".876553.xyz"; nocase; endswith; classtype:trojan-activity; priority:2; sid:1000876004; rev:2;)

# boatnet-docker-etherhiding.rules
# Get Boated: Docker-Delivered Mirai-Linked Malware With EtherHiding C2
# https://github.com/boredchilada/cyfar-detections

# Docker API Archive Upload Into Host-Mounted Path
alert http $EXTERNAL_NET any -> $HOME_NET 2375 (msg:"CYFAR ATTACK Docker API archive upload into host-mounted path"; flow:established,to_server; http.method; content:"PUT"; http.uri; content:"/containers/"; content:"/archive?path=/host/"; distance:0; fast_pattern; classtype:attempted-admin; sid:1000262001; rev:1; metadata:created_at 2026-09-25;)

# Boatnet Execution Argument in Docker API Request
alert http $EXTERNAL_NET any -> $HOME_NET 2375 (msg:"CYFAR MALWARE Boatnet execution argument in Docker API request body"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/containers/"; http.request_body; content:"|e5 ba 94 e7 94 a8|-docker"; fast_pattern; classtype:trojan-activity; sid:1000262002; rev:1; metadata:created_at 2026-09-25;)
